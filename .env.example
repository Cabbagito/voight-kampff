# Copy to .env (gitignored) and fill in. Loaded by topics/*/pv.py and judge.py via python-dotenv.

# Anthropic API key for the LLM judge (console.anthropic.com -> API keys).
# Leave it empty if this machine is logged in with `ant auth login` instead.
ANTHROPIC_API_KEY=

# Hugging Face token. Optional: Qwen3 weights are public; a token only lifts download rate limits.
# HF_TOKEN=hf_...
